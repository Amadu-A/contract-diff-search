# .env.example
# Полный каталог настроек; .env содержит только реальные ключи и пароли.
APP_HOST=0.0.0.0
COMPARISON_EXCLUSIONS_FILE=config/comparison_exclusions.txt
APP_BIND_IP=192.168.55.3
APP_PORT=8082
DATA_DIR=.data
PROCESS_TEMP_DIR=.data/tmp
MAX_FILE_MB=100
MAX_PAGES=300
MAX_UNPACKED_MB=300
MAX_XML_MB=20
MAX_JOBS=20
MAX_SESSION_JOBS=2
RETENTION_SECONDS=3600
JOB_TIMEOUT_SECONDS=3600
PROCESS_TIMEOUT_SECONDS=180
CLEANUP_INTERVAL_SECONDS=15
WORKER_CONCURRENCY=1
NATIVE_THREADS=1
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
BLIS_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1
OMP_THREAD_LIMIT=1
WORKER_HEALTH_TIMEOUT_SECONDS=5
QUEUE_NAME=contract-diff
RABBITMQ_HOST=rabbitmq
RABBITMQ_CONTAINER=shared-rabbitmq-1
RABBITMQ_CLI_TIMEOUT_SECONDS=30
RABBITMQ_PORT=5672
RABBITMQ_VHOST=contract-diff
RABBITMQ_USER=contract-diff
RABBITMQ_PASSWORD=
SHARED_VLM_BASE_URL=http://shared-vlm:8000/v1
SHARED_VLM_MODEL=shared-vlm
VLM_TIMEOUT_SECONDS=90
VLM_MAX_FRAGMENTS=12
# Размер группы заданий, а не ограничение общего охвата.
VLM_BATCH_SIZE=12
VLM_CONCURRENCY=1
VLM_RETRIES=2
VLM_MAX_TOKENS=3072
VLM_MAX_RETRY_TOKENS=6144
VLM_CONTEXT_CHARS=3600
VLM_IMAGE_PIXELS=2000000
VLM_TOTAL_SECONDS=2400
VLM_RETRY_DELAY_SECONDS=0.5
VLM_DISABLE_THINKING=true
VLM_JSON_SCHEMA=true
VLM_REGIONS_PER_REQUEST=6
OCR_DPI=240
OCR_LANGUAGE=rus+eng
OCR_MIN_CONFIDENCE=0.65
TESSERACT_COMMAND=tesseract
SOFFICE_COMMAND=soffice
# Для HTTPS задайте true в baseline окружения развёртывания либо process environment.
COOKIE_SECURE=false
LOG_LEVEL=INFO
MAX_PAGE_PIXELS=24000000
MAX_ELEMENTS=30000
# Интеграция выключена до задания секрета в .env; пользовательский адрес задан явно для LAN.
TELEGRAM_INTEGRATION_TOKEN=
PUBLIC_BASE_URL=http://192.168.55.3:8082
TELEGRAM_CLIENT_ID=telegram-bot
TELEGRAM_MAX_ACTIVE_JOBS=4
TELEGRAM_REQUESTS_PER_MINUTE=120
TELEGRAM_UPLOADS_PER_MINUTE=6
ACCESS_LINK_SECONDS=900
ACCESS_EXCHANGE_PER_MINUTE=20
