# .env.example
# Полный каталог настроек; .env содержит только реальные ключи и пароли.
APP_HOST=0.0.0.0
APP_BIND_IP=192.168.55.3
APP_PORT=8082
DATA_DIR=.data
PROCESS_TEMP_DIR=.data/tmp
MAX_FILE_MB=100
MAX_PAGES=300
MAX_UNPACKED_MB=300
MAX_XML_MB=20
MAX_JOBS=20
MAX_SESSION_JOBS=2
RETENTION_SECONDS=3600
JOB_TIMEOUT_SECONDS=3600
PROCESS_TIMEOUT_SECONDS=180
CLEANUP_INTERVAL_SECONDS=15
WORKER_CONCURRENCY=1
QUEUE_NAME=contract-diff
RABBITMQ_HOST=rabbitmq
RABBITMQ_CONTAINER=shared-rabbitmq-1
RABBITMQ_CLI_TIMEOUT_SECONDS=30
RABBITMQ_PORT=5672
RABBITMQ_VHOST=contract-diff
RABBITMQ_USER=contract-diff
RABBITMQ_PASSWORD=
SHARED_VLM_BASE_URL=http://shared-vlm:8000/v1
SHARED_VLM_MODEL=shared-vlm
VLM_TIMEOUT_SECONDS=30
VLM_MAX_FRAGMENTS=12
OCR_DPI=240
OCR_LANGUAGE=rus+eng
OCR_MIN_CONFIDENCE=0.65
TESSERACT_COMMAND=tesseract
SOFFICE_COMMAND=soffice
# Для HTTPS задайте true в baseline окружения развёртывания либо process environment.
COOKIE_SECURE=false
LOG_LEVEL=INFO
MAX_PAGE_PIXELS=24000000
MAX_ELEMENTS=30000
